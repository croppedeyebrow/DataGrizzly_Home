# Names only. This file has no passwords, tokens, or private keys.
# Copy to .env on the server machine. .env stays untracked.

# BROWSER_PUBLIC
# No PUBLIC_ variable is defined. Do not put server secrets in PUBLIC_ or VITE_.

# SERVER_ONLY
# The public web does not read these. services/api reads them from the process
# environment. This file keeps the names only.
# DB_URL=postgres://127.0.0.1:15432/datagrizzly
# DB_USER=datagrizzly
# DB_PASSWORD=
# OWNER_PASSWORD is read only when the owner table is empty.
# OWNER_PASSWORD_RESET=1 replaces the stored hash. Leave both unset until needed.
# SECURE_COOKIES=1 adds Secure to the session cookie. Local HTTP leaves it unset.
# OWNER_PASSWORD=
# OWNER_PASSWORD_RESET=
# SECURE_COOKIES=

# COMPOSE_ONLY
# infra/local/compose.yaml reads POSTGRES_PASSWORD from the untracked .env.
# User and database are datagrizzly. This file keeps the name only.
# POSTGRES_PASSWORD=

# WORKFLOW
# The worker reads these from the process environment. It does not load .env.
# CMS_INTERNAL_BASE_URL=http://127.0.0.1:8080
# WORKFLOW_SETUP_DSN=postgresql://datagrizzly@127.0.0.1:15432/datagrizzly
# WORKFLOW_CHECKPOINT_DSN=postgresql://workflow_runtime@127.0.0.1:15432/datagrizzly
# WORKFLOW_RUNTIME_PASSWORD=
# WORKFLOW_TOKEN=
# WORKFLOW_VERSION=1
# WORKFLOW_MAX_JOBS=1
# DG_CONTENT_BIN is an explicit path to dg-content. A Windows path is not converted into a WSL path.
# DG_CONTENT_WSL_DISTRO=
# DG_CONTENT_LINUX_PATH=
