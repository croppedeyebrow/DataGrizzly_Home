# Names only. This file has no passwords, tokens, or private keys.
# Copy to .env on the server machine. .env stays untracked.

# BROWSER_PUBLIC
# No PUBLIC_ variable is defined. Do not put server secrets in PUBLIC_ or VITE_.

# SERVER_ONLY
# The public web does not read these. services/api reads them from the process
# environment. This file keeps the names only.
# DB_URL=postgres://127.0.0.1:15432/datagrizzly
# DB_USER=datagrizzly
# DB_PASSWORD=

# COMPOSE_ONLY
# infra/local/compose.yaml reads POSTGRES_PASSWORD from the untracked .env.
# User and database are datagrizzly. This file keeps the name only.
# POSTGRES_PASSWORD=
