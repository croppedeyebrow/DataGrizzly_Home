# Names only. This file has no passwords, tokens, or private keys.
# Copy to .env on the server machine. .env stays untracked.

# BROWSER_PUBLIC
# Astro exposes PUBLIC_ values to the browser bundle.
# No PUBLIC_ variable is defined. Do not put server secrets in PUBLIC_ or VITE_.

# SERVER_ONLY
# The public web does not read these. S14 CMS will read them from the local process,
# not from a committed file. Leave the values empty until that stage.
# DB_URL=jdbc:postgresql://127.0.0.1:15432/datagrizzly
# DB_USER=
# DB_PASSWORD=
