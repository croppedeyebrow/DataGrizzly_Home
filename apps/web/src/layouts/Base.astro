---
/**
 * 개념: 공개 웹의 공통 틀.
 * 목적: 건너뛰기 링크, 헤더, 현재 메뉴, 본문 하나, 푸터를 페이지가 반복하지 않게 한다.
 * 사용처: apps/web/src/pages 의 홈, 소개, 프로젝트, 과정, 노트, 리서치, 주제, 시리즈, 404
 */
import '../styles/global.css';
import { buildMeta } from '../../../../packages/seo/meta.mjs';
import { siteOrigin } from '../../../../packages/seo/site-origin.mjs';

interface Props {
  title: string;
  current: '/' | '/about' | '/projects' | '/notes' | '/research' | null;
  canonical?: string;
  description?: string;
  date?: string;
  dateKind?: 'published' | 'modified';
  includeCanonical?: boolean;
  noindex?: boolean;
}

const {
  title,
  current,
  canonical = current ?? '/',
  description = '공개 예시 글을 정적 페이지로 보여 준다. API는 아직 연결하지 않았다.',
  date = '',
  dateKind = 'published',
  includeCanonical = true,
  noindex = false,
} = Astro.props;
/* 도메인이 비어 있으면 canonical은 경로만 적는다. 메뉴 강조는 current를 쓴다. */
const meta = buildMeta({ title, description, path: includeCanonical ? canonical : '', date, siteOrigin }) as {
  title: string;
  description: string;
  canonical: string;
  author: string;
  date: string;
  og: { title: string; description: string; url: string; type: string };
};
const items = [
  { href: '/', label: '홈' },
  { href: '/projects', label: '프로젝트' },
  { href: '/notes', label: '노트' },
  { href: '/research', label: '리서치' },
  { href: '/about', label: '소개' },
];
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{meta.title}</title>
    {meta.description && <meta name="description" content={meta.description} />}
    <meta name="author" content={meta.author} />
    {noindex && <meta name="robots" content="noindex" />}
    {includeCanonical && meta.canonical && <link rel="canonical" href={meta.canonical} />}
    <meta property="og:title" content={meta.og.title} />
    {meta.og.description && <meta property="og:description" content={meta.og.description} />}
    <meta property="og:type" content={meta.og.type} />
    {includeCanonical && meta.canonical && <meta property="og:url" content={meta.og.url} />}
    {meta.date && dateKind === 'modified' && <meta property="article:modified_time" content={meta.date} />}
    {meta.date && dateKind === 'published' && <meta property="article:published_time" content={meta.date} />}
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <header class="site-header">
      <div class="shell">
        <a class="brand" href="/">DataGrizzly</a>
        <details id="site-menu" class="site-menu">
          <summary>메뉴</summary>
          <nav class="site-nav" aria-label="공개 웹">
            <ul>
              {
                items.map((item) => (
                  <li>
                    <a href={item.href} aria-current={item.href === current ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </details>
      </div>
    </header>
    <main id="main" class="shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell">
        <p>예시로 표시된 글은 실제 성과가 아니다. API는 아직 연결하지 않았다.</p>
      </div>
    </footer>
    <script>
      import { setupSiteMenu } from '../scripts/site-menu.ts';
      setupSiteMenu(document.querySelector('#site-menu'));
    </script>
  </body>
</html>
