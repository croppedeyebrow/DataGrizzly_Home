---
/**
 * 개념: 없는 공개 주소.
 * 목적: 알 수 없는 주소와 아직 없는 검색을 구분하고, 공개 글로 돌아가는 링크를 HTML에 둔다.
 * 사용처: 공개 경로 `/404`와 정적 호스트의 없는 주소. canonical은 두지 않는다.
 */
import Base from '../layouts/Base.astro';
---

<Base
  title="페이지를 찾을 수 없다 · DataGrizzly"
  current={null}
  includeCanonical={false}
  noindex={true}
  description="이 주소의 공개 글은 없다."
>
  <h1>페이지를 찾을 수 없다</h1>
  <p>이 주소의 공개 글은 없다.</p>
  <p class="empty-state">검색은 아직 연결하지 않았다. 검색어가 없는 결과 페이지도 만들지 않는다.</p>
  <p>공개 글 읽기는 아래 목록에서 계속할 수 있다.</p>
  <p class="start-links">
    <a href="/">홈</a>
    <a href="/projects">프로젝트</a>
    <a href="/notes">노트</a>
    <a href="/research">리서치</a>
    <a href="/about">소개</a>
  </p>
</Base>
