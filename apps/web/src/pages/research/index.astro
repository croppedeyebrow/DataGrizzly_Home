---
/**
 * 개념: 공개 논문과 뉴스 목록.
 * 목적: 두 종류를 한 목록에서 구분하고, 논문 주장과 뉴스 날짜를 각자 보여 준다.
 * 사용처: 공개 경로 `/research`.
 */
import Base from '../../layouts/Base.astro';
import { loadPublicResearch } from '../../../../../scripts/public-research.mjs';
import type { ResearchSite } from '../../scripts/research-types.ts';

const site = loadPublicResearch('../../fixtures/content') as ResearchSite;
---

<Base title="리서치 · DataGrizzly" current="/research">
  <h1>리서치</h1>
  <p>논문과 뉴스를 같은 경로에서 종류로 구분한다.</p>
  <p class="meta">논문과 뉴스를 거르는 필터는 아직 없다.</p>
  {
    site.loadError ? (
      <p class="empty-state">예시 파일을 읽지 못했다. 이 페이지는 빈 목록으로 남는다.</p>
    ) : site.research.length === 0 ? (
      <p class="empty-state">공개 리서치가 아직 없다.</p>
    ) : (
      <ul class="project-list">
        {site.research.map((article) => (
          <li class="project-card">
            <p class="meta">{article.kind === 'paper' ? '논문' : '뉴스'}</p>
            <h2><a href={`/research/${article.slug}`}>{article.title}</a></h2>
            <p class="example-flag">예시이며 실제 성과가 아니다.</p>
            {article.kind === 'paper' ? (
              <>
                <p>{article.claim}</p>
                <p>{article.reproduction}</p>
              </>
            ) : (
              <>
                <p>{article.eventDate}</p>
                <p>{article.publicationDate}</p>
              </>
            )}
          </li>
        ))}
      </ul>
    )
  }
</Base>
