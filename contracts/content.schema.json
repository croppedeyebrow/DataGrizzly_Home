{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datagrizzly.local/schemas/content/1",
  "title": "DataGrizzly content schema",
  "$comment": "schemaVersion 1. Unknown fields and unsupported block types fail. This file does not check that a projectId exists in a database.",
  "type": "object",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "utcDateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "httpsUrl": {
      "type": "string",
      "minLength": 12,
      "maxLength": 500,
      "pattern": "^https://[^\\s]+$"
    },
    "anchor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "type": { "const": "paragraph" },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "level", "text", "anchor"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "type": { "const": "heading" },
        "level": { "type": "integer", "minimum": 2, "maximum": 3 },
        "text": { "type": "string", "minLength": 1, "maxLength": 200 },
        "anchor": { "$ref": "#/$defs/anchor" }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "ordered", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "type": { "const": "list" },
        "ordered": { "type": "boolean" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "type": { "const": "quote" },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "citation": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "header", "rows"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "type": { "const": "table" },
        "caption": { "type": "string", "minLength": 1, "maxLength": 200 },
        "header": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "rows": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": { "type": "string", "maxLength": 500 }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "alt", "url"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "type": { "const": "image" },
        "alt": { "type": "string", "minLength": 1, "maxLength": 200 },
        "url": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "language", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "type": { "const": "code" },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z0-9#+.-]+$"
        },
        "text": { "type": "string", "minLength": 1, "maxLength": 20000 }
      }
    },
    "math": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "tex"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "type": { "const": "math" },
        "tex": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "callout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "tone", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "type": { "const": "callout" },
        "tone": { "enum": ["note", "warning"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "related": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "entryId"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "type": { "const": "related" },
        "entryId": { "$ref": "#/$defs/uuid" }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/paragraph" },
        { "$ref": "#/$defs/heading" },
        { "$ref": "#/$defs/list" },
        { "$ref": "#/$defs/quote" },
        { "$ref": "#/$defs/table" },
        { "$ref": "#/$defs/image" },
        { "$ref": "#/$defs/code" },
        { "$ref": "#/$defs/math" },
        { "$ref": "#/$defs/callout" },
        { "$ref": "#/$defs/related" }
      ]
    },
    "logMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "projectId", "stage", "displayOrder"],
      "properties": {
        "type": { "const": "log" },
        "projectId": { "$ref": "#/$defs/uuid" },
        "stage": { "enum": ["planning", "implementation", "verification"] },
        "displayOrder": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "entryMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["project", "note", "paper", "news"] }
      }
    },
    "revisionDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "revisionId", "entryId", "createdAt", "title", "canonicalUrl", "blocks", "metadata"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "revisionId": { "$ref": "#/$defs/uuid" },
        "entryId": { "$ref": "#/$defs/uuid" },
        "createdAt": { "$ref": "#/$defs/utcDateTime" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "canonicalUrl": { "$ref": "#/$defs/httpsUrl" },
        "blocks": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/block" }
        },
        "metadata": {
          "oneOf": [
            { "$ref": "#/$defs/logMetadata" },
            { "$ref": "#/$defs/entryMetadata" }
          ]
        },
        "example": { "type": "boolean" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "entryId", "slug", "type", "version", "draftRevisionId", "publishedRevisionId", "updatedAt"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "entryId": { "$ref": "#/$defs/uuid" },
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "type": { "enum": ["project", "log", "note", "paper", "news"] },
        "version": { "type": "integer", "minimum": 1 },
        "draftRevisionId": { "$ref": "#/$defs/uuid" },
        "publishedRevisionId": {
          "oneOf": [
            { "$ref": "#/$defs/uuid" },
            { "type": "null" }
          ]
        },
        "updatedAt": { "$ref": "#/$defs/utcDateTime" },
        "example": { "type": "boolean" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "code", "message", "requestId"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "code": {
          "enum": ["unauthenticated", "forbidden", "not_found", "conflict", "validation_failed", "rate_limited", "search_unavailable"]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 300 },
        "requestId": {
          "type": "string",
          "pattern": "^req_[A-Za-z0-9]{2,32}$"
        },
        "fieldErrors": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "code"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 200 },
              "code": { "type": "string", "minLength": 1, "maxLength": 80 }
            }
          }
        }
      }
    }
  }
}
